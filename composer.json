{
  "name": "eshaanmanchanda/certificate-generator",
  "description": "Certificate Generator WordPress Plugin",
  "type": "wordpress-plugin",
  "require": {},
  "require-dev": {
    "phpunit/phpunit": "^10",
    "squizlabs/php_codesniffer": "^3",
    "wp-coding-standards/wpcs": "^3",
    "phpstan/phpstan": "^1",
    "szepeviktor/phpstan-wordpress": "^1"
  },
  "scripts": {
    "test": "vendor/bin/phpunit --testdox",
    "lint": "vendor/bin/phpcs --standard=WordPress includes/",
    "lint-fix": "vendor/bin/phpcbf --standard=WordPress includes/",
    "analyse": "vendor/bin/phpstan analyse includes/ --level=5"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
