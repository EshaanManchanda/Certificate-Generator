{
  "name": "eshaanmanchanda/certificate-generator",
  "description": "Certificate Generator WordPress Plugin",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^10",
    "squizlabs/php_codesniffer": "^3",
    "wp-coding-standards/wpcs": "^3",
    "phpstan/phpstan": "^1",
    "szepeviktor/phpstan-wordpress": "^1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "brain/monkey": "^2.6",
    "mockery/mockery": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "CertificateGenerator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CertificateGenerator\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit --testdox",
    "test:coverage": "vendor/bin/phpunit --testdox --coverage-html=coverage",
    "lint": "vendor/bin/phpcs --standard=phpcs.xml",
    "lint-fix": "vendor/bin/phpcbf --standard=phpcs.xml",
    "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
    "fix": "vendor/bin/phpcbf --standard=phpcs.xml"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
